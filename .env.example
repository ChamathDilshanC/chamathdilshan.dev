# Frontend environment — chamathdilshan.dev
# Copy to .env.local and fill in. Never commit .env.local.

# Public (exposed to the browser — nothing secret here)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only: shared secret the backend uses to call /api/revalidate
# Must match CACHE_REVALIDATE_SECRET in the backend. (CACHING.md §8.3)
CACHE_REVALIDATE_SECRET=
