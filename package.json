    "export:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/export-seed.mts"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.50.0",
    "clsx": "^2.1.1",
    "goey-toast": "^0.5.0",
    "lenis": "^1.3.27",
    "motion": "^12.43.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swr": "^2.2.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "openapi-typescript": "^7.4.0",
    "prettier": "^3.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
