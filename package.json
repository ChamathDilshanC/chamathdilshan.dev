  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "gen:api": "openapi-typescript $NEXT_PUBLIC_API_URL/openapi.json -o lib/api-types.ts",
